{
  "name": "repo-run",
  "version": "0.1.1",
  "description": "From repository to running, without the guesswork.",
  "author": "Repo Run",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "format": "prettier --write .",
    "icons": "node scripts/icons.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@supabase/supabase-js": "^2.57.4",
    "cross-spawn": "^7.0.6",
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "semver": "^7.7.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  }
}
